{% import "_macros.j2" as ui %}<!DOCTYPE html>
<html lang="en">
<head>
{{ ui.head_assets(source.owner ~ "/" ~ source.name ~ " — Software Health Report", accent) }}
</head>
<body>
<div class="wrap">

  {{ ui.topbar(report.schema_version, metrics_version, generated) }}

  <div class="repo-head">
    <div>
      <h1 class="repo-name">
        <a href="{{ repo_url }}"><span class="owner">{{ source.owner }} /</span> {{ source.name }}</a>
      </h1>
      {% if data.repo.description %}<p class="repo-desc">{{ data.repo.description }}</p>{% endif %}
      <div class="chips">
        {% if ownership and ownership.is_org %}
        <span class="chip"><i data-lucide="building-2"></i>{{ ownership.owner.name or ownership.owner.login }}{% if ownership.owner.is_verified %} ✓{% endif %}</span>
        {% elif data.repo.owner_type == "User" %}
        <span class="chip"><i data-lucide="user"></i>personal repository</span>
        {% endif %}
        {% if data.repo.primary_language %}<span class="chip"><i data-lucide="code"></i>{{ data.repo.primary_language }}</span>{% endif %}
        <span class="chip"><i data-lucide="scale"></i>{{ data.repo.license_spdx or "No license detected" }}</span>
        <span class="chip"><i data-lucide="star"></i>{{ "{:,}".format(data.popularity.stars) }} stars</span>
        <span class="chip"><i data-lucide="git-fork"></i>{{ "{:,}".format(data.popularity.forks) }} forks</span>
        {% if data.repo.created_at %}<span class="chip"><i data-lucide="calendar"></i>since {{ data.repo.created_at.strftime("%b %Y") }}</span>{% endif %}
        {% if data.repo.is_archived %}<span class="chip warn"><i data-lucide="archive"></i>archived</span>{% endif %}
        {% if data.repo.is_fork %}<span class="chip warn"><i data-lucide="git-branch"></i>fork</span>{% endif %}
      </div>
    </div>
  </div>

  <div class="hero">
    {{ ui.gauge_card(overall, overall_band, "overall / 100") }}
    {{ ui.band_scale_card(bands, overall, "Software health score",
        "Ten metrics grouped into five categories, all on one standardized 1–100 scale. The overall score is a weighted mean of the categories — but read the full profile: a single number can mask a critical risk.") }}
  </div>

  {{ ui.radar_card("Each axis is a category. " ~ (overall.note if overall and overall.note else "")) }}

  {% if ownership %}{{ ui.ownership_section(ownership) }}{% endif %}
  {% if ecosystem_packages %}{{ ui.ecosystem_section(ecosystem_packages) }}{% endif %}

  <div class="section-title"><i data-lucide="gauge"></i><h2>Metrics by category</h2></div>
  {% for cat in category_views %}
  {{ ui.category_block(cat) }}
  {% endfor %}

  <div class="section-title"><i data-lucide="database"></i><h2>Key facts</h2></div>
  <div class="facts">
    <div class="card fact"><b>{{ "{:,}".format(data.popularity.stars) }}</b><span>GitHub stars</span></div>
    <div class="card fact"><b>{{ data.maintainership.contributors_sampled if data.maintainership.contributors_sampled is not none else "—" }}</b><span>contributors</span></div>
    <div class="card fact"><b>{{ "{:,}".format(data.activity.commits_last_year) if data.activity.commits_last_year is not none else "—" }}</b><span>commits, last 12 months</span></div>
    <div class="card fact"><b>{{ data.activity.days_since_last_push if data.activity.days_since_last_push is not none else "—" }}</b><span>days since last push</span></div>
    <div class="card fact"><b>{{ data.activity.releases_count if data.activity.releases_count is not none else "—" }}</b><span>releases</span></div>
    <div class="card fact"><b>{{ data.maintainership.bus_factor if data.maintainership.bus_factor is not none else "—" }}</b><span>bus factor</span></div>
    <div class="card fact"><b>{{ data.maintainership.issues.open_issues if data.maintainership.issues.open_issues is not none else "—" }}</b><span>open issues</span></div>
    <div class="card fact"><b>{{ data.dependencies.ecosystems | join(", ") if data.dependencies.ecosystems else "—" }}</b><span>package ecosystems</span></div>
  </div>

  {{ ui.warnings_card(warnings) }}
  {{ ui.raw_json_card(report_json) }}
  {{ ui.footer(metrics_version, report.schema_version) }}
</div>

{{ ui.chart_script(chart_json) }}
</body>
</html>
