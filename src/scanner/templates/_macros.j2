{% macro head_assets(title, accent) -%}
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js" defer></script>
<script src="https://cdn.jsdelivr.net/npm/lucide@0.469.0/dist/umd/lucide.min.js" defer></script>
<style>{% include "_style.css" %}</style>
<style>:root { --accent: {{ accent }}; }</style>
{%- endmacro %}

{% macro topbar(schema_version, metrics_version, generated) -%}
<div class="topbar">
  <div class="brand"><i data-lucide="scan-search"></i> inspect-software · scanner</div>
  <div class="versions">schema {{ schema_version }}{% if metrics_version %} · metrics {{ metrics_version }}{% endif %} · {{ generated }}</div>
</div>
{%- endmacro %}

{% macro gauge_card(overall, overall_band, unit_label) -%}
<div class="card gauge-card">
  {% if overall %}
  <div class="gauge">
    <svg width="200" height="200" viewBox="0 0 200 200">
      <circle cx="100" cy="100" r="86" fill="none" stroke="var(--line)" stroke-width="16"/>
      <circle cx="100" cy="100" r="86" fill="none" stroke="{{ overall_band.color }}" stroke-width="16"
              stroke-linecap="round"
              stroke-dasharray="{{ '%.1f' % (overall.value * 5.404) }} 540.4"/>
    </svg>
    <div class="num"><b>{{ overall.value }}</b><span>{{ unit_label }}</span></div>
  </div>
  <span class="band-pill" style="background: {{ overall_band.color }}">{{ overall_band.label }}</span>
  <div class="meaning">{{ overall_band.meaning }}</div>
  {% else %}
  <div class="metric-missing">Not enough public data to compute an overall score.</div>
  {% endif %}
</div>
{%- endmacro %}

{% macro band_scale_card(bands, overall, title, subtitle) -%}
<div class="card scale-card">
  <h2>{{ title }}</h2>
  <p class="scale-sub">{{ subtitle }}</p>
  {% if overall %}
  <div class="scale-marker"><span class="pin" style="left: {{ overall.value }}%">{{ overall.value }}</span></div>
  {% endif %}
  <div class="scale-track">
    <i style="width:29%; background:#ef4444"></i>
    <i style="width:20%; background:#f97316"></i>
    <i style="width:20%; background:#f59e0b"></i>
    <i style="width:15%; background:#84cc16"></i>
    <i style="width:16%; background:#10b981"></i>
  </div>
  <div class="band-rows" style="margin-top: 12px;">
    {% for b in bands %}
    <div class="band-row">
      <span class="dot" style="background: {{ b.color }}"></span>
      <b>{{ b.label }}</b>
      <span class="rng">{{ b.range }}</span>
      <span>{{ b.meaning }}</span>
    </div>
    {% endfor %}
  </div>
</div>
{%- endmacro %}

{% macro metric_card(m) -%}
<div class="card" id="metric-{{ m.key }}">
  <div class="metric-head">
    <div class="icon" style="color: {{ m.color }}"><i data-lucide="{{ m.icon }}"></i></div>
    <div>
      <h3>{{ m.name }}</h3>
      <div class="q">{{ m.question }}</div>
    </div>
    <div class="metric-score">
      <b>{{ m.value }}</b>
      <small style="color: {{ m.color }}">{{ m.band_label }}</small>
    </div>
  </div>
  <div class="bar"><i style="width: {{ m.value }}%; background: {{ m.color }}"></i></div>
  <div class="metric-body">
    <p>{{ m.explanation }}</p>
    <details>
      <summary>How it's scored</summary>
      <div class="inner">
        <table class="comp-table">
          {% if m.component_rows %}
          {% for c in m.component_rows %}
          <tr class="comp-{{ c.status }}">
            <td class="ic"><i data-lucide="{{ c.icon }}" style="color: {{ c.color }}"></i></td>
            <td class="w" style="color: {{ c.color }}">{{ c.pts }}</td>
            <td{% if c.hint %} title="{{ c.hint }}"{% endif %}>{{ c.name }}{% if c.detail %} <span class="hint">— {{ c.detail }}</span>{% endif %}</td>
          </tr>
          {% endfor %}
          {% else %}
          {% for name, weight, hint in m.static_components %}
          <tr><td class="ic"></td><td class="w">{{ weight }} pts</td><td>{{ name }}{% if hint %} <span class="hint">— {{ hint }}</span>{% endif %}</td></tr>
          {% endfor %}
          {% endif %}
        </table>
        {% if m.weight_pct %}<div class="metric-weight" style="margin-top:8px;">Weight in overall score: {{ m.weight_pct }}%</div>{% endif %}
      </div>
    </details>
    <details>
      <summary>Inputs used</summary>
      <div class="inner">
        <table class="inputs-table">
          {% for k, v in m.inputs %}
          <tr><td class="k">{{ k }}</td><td class="v">{{ v }}</td></tr>
          {% endfor %}
        </table>
      </div>
    </details>
    {% if m.note %}<div class="metric-note">{{ m.note }}</div>{% endif %}
  </div>
</div>
{%- endmacro %}

{% macro category_block(cat) -%}
<div class="category">
  <div class="category-head">
    <div class="category-title">
      <span class="category-icon" style="color: {{ cat.color }}"><i data-lucide="{{ cat.icon }}"></i></span>
      <div>
        <h2>{{ cat.name }}</h2>
        <p>{{ cat.description }}</p>
      </div>
    </div>
    {% if cat.value %}
    <div class="category-score">
      <span class="cat-badge" style="background: {{ cat.color }}">{{ cat.value }}</span>
      <span class="cat-meta">{{ cat.band_label }} · {{ cat.weight_pct }}% of overall</span>
    </div>
    {% endif %}
  </div>
  <div class="metrics-grid">
    {% for m in cat.metrics %}
    {{ metric_card(m) }}
    {% endfor %}
  </div>
</div>
{%- endmacro %}

{% macro ownership_section(ownership) -%}
{% set o = ownership.owner %}
<div class="section-title"><i data-lucide="landmark"></i><h2>Ownership</h2></div>
<div class="card ownership">
  <div class="owner-head">
    {% if o.avatar_url %}<img class="avatar" src="{{ o.avatar_url }}" alt="">{% endif %}
    <div class="owner-id">
      <div class="owner-name">
        <a href="https://github.com/{{ o.login }}">{{ o.name or o.login }}</a>
        {% if ownership.is_org %}
        <span class="tag tag-org"><i data-lucide="building-2"></i>Organization{% if o.is_verified %} · verified domain{% endif %}</span>
        {% else %}
        <span class="tag tag-user"><i data-lucide="user"></i>Personal account</span>
        {% endif %}
      </div>
      <div class="owner-facts">
        <span><i data-lucide="users"></i>{{ "{:,}".format(o.followers) }} followers</span>
        <span><i data-lucide="folder-git-2"></i>{{ "{:,}".format(o.public_repos) }} public repos</span>
        {% if o.created_at %}<span><i data-lucide="calendar"></i>since {{ o.created_at.strftime("%b %Y") }}</span>{% endif %}
        {% if o.company %}<span><i data-lucide="briefcase"></i>{{ o.company }}</span>{% endif %}
      </div>
      <p class="owner-note">
        {% if ownership.is_org %}
        This repository is backed by an <b>organization</b> — shared, accountable stewardship that can outlive any single maintainer. That backing lifts the stewardship score.
        {% else %}
        This repository is owned by a <b>personal account</b>. A single-owner project carries more continuity risk than an organization-backed one, which the stewardship score reflects.
        {% endif %}
      </p>
    </div>
    {% if ownership.steward %}
    <a class="owner-score" href="#metric-stewardship" style="border-color: {{ ownership.steward.color }}">
      <b style="color: {{ ownership.steward.color }}">{{ ownership.steward.value }}</b>
      <span>stewardship<br>{{ ownership.steward.band_label }}</span>
    </a>
    {% endif %}
  </div>
</div>
{%- endmacro %}

{% macro radar_card(note) -%}
<div class="card radar-card">
  <div class="radar-box"><canvas id="radar"></canvas></div>
  <div class="radar-side">
    <h2>Score profile</h2>
    <p>The shape matters more than the average. A healthy subject fills the whole shape; a spike-and-crater profile means strength in one dimension is masking risk in another.</p>
    {% if note %}<p class="metric-note">{{ note }}</p>{% endif %}
  </div>
</div>
{%- endmacro %}

{% macro warnings_card(warnings) -%}
{% if warnings %}
<div class="card warn-card" style="margin-top: 20px;">
  <h2><i data-lucide="triangle-alert"></i>Data collection warnings</h2>
  <ul>
    {% for w in warnings %}<li>{{ w }}</li>{% endfor %}
  </ul>
</div>
{% endif %}
{%- endmacro %}

{% macro raw_json_card(report_json) -%}
<div class="section-title"><i data-lucide="file-json"></i><h2>Full report data</h2></div>
<div class="card">
  <details>
    <summary>Raw JSON report (data + metrics, machine-readable)</summary>
    <div class="inner" style="padding-top: 12px;">
      <pre class="raw">{{ report_json }}</pre>
    </div>
  </details>
</div>
{%- endmacro %}

{% macro footer(metrics_version, schema_version) -%}
<div class="foot">
  <p><b>Scores are signals, not warranties.</b> They reflect publicly visible practices on GitHub — not a code audit, and not a security guarantee.</p>
  <p>Missing data is excluded and weights renormalized, never scored as zero. Methodology is versioned and open: metrics v{{ metrics_version or "—" }}, schema v{{ schema_version }}.</p>
</div>
{%- endmacro %}

{% macro chart_script(chart_json) -%}
<script id="chart-data" type="application/json">{{ chart_json | safe }}</script>
<script>
window.addEventListener("DOMContentLoaded", function () {
  if (window.lucide) lucide.createIcons();
  if (!window.Chart) return;
  var payload = JSON.parse(document.getElementById("chart-data").textContent);
  if (!payload.labels.length) return;
  new Chart(document.getElementById("radar"), {
    type: "radar",
    data: {
      labels: payload.labels.map(function (l) { return l.split(" "); }),
      datasets: [{
        data: payload.values,
        fill: true,
        backgroundColor: payload.color + "26",
        borderColor: payload.color,
        borderWidth: 2,
        pointBackgroundColor: payload.color,
        pointRadius: 3.5
      }]
    },
    options: {
      maintainAspectRatio: false,
      plugins: { legend: { display: false } },
      scales: {
        r: {
          min: 0, max: 100,
          ticks: { stepSize: 25, color: "#94a3b8", backdropColor: "transparent", font: { size: 10 } },
          grid: { color: "#e2e8f0" },
          angleLines: { color: "#e2e8f0" },
          pointLabels: { color: "#334155", font: { size: 11.5, weight: 600, family: "Inter" } }
        }
      }
    }
  });
});
</script>
{%- endmacro %}
